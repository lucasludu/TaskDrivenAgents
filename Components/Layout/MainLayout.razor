@inherits LayoutComponentBase

<MudThemeProvider Theme="_customTheme" DefaultScrollbar="true" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudMainContent Class="pa-0">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _customTheme = new()
    {
        PaletteDark = new PaletteDark()
        {
            Primary = "#818cf8",      // Indigo
            Secondary = "#f472b6",    // Pink
            Background = "#090d16",   // Deep Space
            Surface = "#0f172a",      // Slate dark
            AppbarBackground = "#0f172a",
            TextPrimary = "#f3f4f6",
            TextSecondary = "#9ca3af",
            DrawerBackground = "#0f172a",
            ActionDefault = "#9ca3af",
            Divider = "#1e293b",
        }
    };
}
